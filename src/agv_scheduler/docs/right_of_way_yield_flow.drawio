<mxfile host="app.diagrams.net" type="device">
  <diagram id="row-yield-flow" name="路径冲突让行策略">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="AGV 路径冲突 · 让行 / 路权策略（Right-of-Way）" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="10" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- ===== detection (检测) ===== -->
        <mxCell id="n1" value="每 0.2s：_safety_loop 扫描每一对 AGV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="两车都 IDLE？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="dist &lt; safety_stop_distance？&#10;(默认 1.0m)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="该对已有 ConflictLock？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="390" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- ===== victim ladder (谁让行 _right_of_way_victim) ===== -->
        <mxCell id="n5" value="任一方 WAITING&#10;或处于让行冷却？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="一方低电量 / 去充电，&#10;另一方不是？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="一方有任务，&#10;另一方空闲？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="800" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="一方在移动，&#10;另一方已停？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="920" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="_lower_priority_agv：优先级低者让；&#10;相等 → 让行次数 yield_count 少者让（两车轮流）；&#10;再相等 → aid 兜底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="1040" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="创建 ConflictLock（winner, loser, zones）&#10;—— 记住结论，后续 tick 不重判" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="1160" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- ===== yield (怎么让 _yield_for_right_of_way) ===== -->
        <mxCell id="n11" value="_yield_for_right_of_way(loser)：&#10;• 退避到安全等待点（或原地停）&#10;• state=WAITING，yielding_to=winner&#10;• yield_cooldown_until = now+hold+cooldown&#10;• yield_count += 1&#10;• 取消旧 Nav2 goal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="1260" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="loser 抵达等待点（≤ wait_release_tolerance）&#10;→ 在 _nav_done 释放走廊路线预约，让 winner 通过" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="1430" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- ===== recovery (何时恢复 _right_of_way_loop) ===== -->
        <mxCell id="rhdr" value="恢复：_right_of_way_loop（每 0.2s）" style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="1520" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="wait_until 已到（过最短保持）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="1550" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="仍需继续让行？&#10;winner 仍在主动行驶（有在途 goal 且非 idle/charging/waiting）&#10;且保持未超 yield_max_hold_duration&#10;且距离仍 &lt; release_distance（1.6m）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="1670" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="_prepare_stage_dispatch_locked&#10;(wait_on_block=False) 重抢路线预约" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="1870" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="预约抢到？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="1970" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="续行：清等待字段 + 清本车 ConflictLock，&#10;_send_nav，打印 [RESUME]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="2090" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="冲突化解（无碰撞、无死锁）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="2200" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- ===== right column terminals ===== -->
        <mxCell id="n19" value="跳过：都停着，不算冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="160" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="跳过：未逼近到安全距离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="280" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="沿用既有 winner / loser&#10;（不重判，防 A↔B 互让）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="400" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="返回 None：已在让 / 冷却中，&#10;本 tick 不处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="525" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="继续保持 WAITING&#10;（下个 0.2s tick 再评估）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1700" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- ===== legend / two-layer note ===== -->
        <mxCell id="n24" value="两层防撞模型&#10;① 路线预约（事前，第 1 层）：发车 / 换阶段前把途经 cell / traffic / dock 资源互斥预约，拿不到就不发 Nav2 goal —— 多数冲突在此被提前串行化。&#10;② 路权让行（本图，第 2 层运行时安全网）：两车物理逼近到 safety_stop_distance 时按路权让其一退避腾道。&#10;&#10;黄色块 = 近期修复点：&#10;• yield_count 公平轮流让行&#10;• 抵达等待点即释放走廊预约（wait_release_tolerance）&#10;• 保活：winner 泊车或超 yield_max_hold_duration 即续行，绝不永久 WAITING&#10;&#10;续行后 _safety_loop 仍每 0.2s 实时兜底：再次贴近会重新触发让行。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="640" width="470" height="380" as="geometry" />
        </mxCell>

        <!-- ===== edges ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n2" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n3" target="n20"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n4" target="n21"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n21" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n5" target="n22"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="是 → 高电量方让" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="是 → 有任务方让" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="是 → 移动方让" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" value="否（未到）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n13" target="n23"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" value="是（仍需让，原地等）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n14" target="n23"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e24" value="否：winner 已泊车 / 已分离 / 超保持上限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e26" value="否（仍被占）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n16" target="n23"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e27" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e29" value="下个 tick 再评估" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
