<?xml version="1.0"?>
<sdf version="1.6">
  <world name="agv_warehouse">

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun_main" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light name="light_1" type="point">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 四面墙 -->
    <model name="wall_north">
      <static>true</static><pose>0 12 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>26 0.25 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>26 0.25 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -12 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>26 0.25 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>26 0.25 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>13 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>24 0.25 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.25 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-13 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>24 0.25 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.25 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient></material></visual>
      </link>
    </model>

    <!-- ===== 货架组（复现截图中的密集货架布局）===== -->
    <!-- 货架宏: 每排4个货架单元，共4排 -->

    <!-- 排A: y=7 -->
    <model name="shelf_A1"><static>true</static><pose>-9 7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>
    <model name="shelf_A2"><static>true</static><pose>-5 7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>
    <model name="shelf_A3"><static>true</static><pose>-1 7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>
    <model name="shelf_A4"><static>true</static><pose>3 7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>

    <!-- 排B: y=3 -->
    <model name="shelf_B1"><static>true</static><pose>-9 3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>
    <model name="shelf_B2"><static>true</static><pose>-5 3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>
    <model name="shelf_B3"><static>true</static><pose>-1 3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>
    <model name="shelf_B4"><static>true</static><pose>3 3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>

    <!-- 排C: y=-3 -->
    <model name="shelf_C1"><static>true</static><pose>-9 -3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>
    <model name="shelf_C2"><static>true</static><pose>-5 -3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>
    <model name="shelf_C3"><static>true</static><pose>-1 -3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>
    <model name="shelf_C4"><static>true</static><pose>3 -3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient></material></visual>
      </link></model>

    <!-- 排D: y=-7 -->
    <model name="shelf_D1"><static>true</static><pose>-9 -7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>
    <model name="shelf_D2"><static>true</static><pose>-5 -7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>
    <model name="shelf_D3"><static>true</static><pose>-1 -7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>
    <model name="shelf_D4"><static>true</static><pose>3 -7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 2.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 2.5 1.8</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient></material></visual>
      </link></model>

    <!-- 出货站台 -->
    <model name="output_station">
      <static>true</static><pose>9 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 2.0 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 2.0 0.4</size></box></geometry>
          <material><ambient>0.15 0.55 0.85 1</ambient></material></visual>
      </link>
    </model>

    <!-- 充电桩 -->
    <model name="charging_pad">
      <static>true</static><pose>9 -8 0.05 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.5 1.5 0.1</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>1.5 1.5 0.1</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
